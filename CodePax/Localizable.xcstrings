{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@:%@\n\n%@\n\n请与服务器上的 SSH 主机指纹核对。确认后保存，下次连接会自动校验。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@\n\n%@\n\nCompare this with the server's SSH host fingerprint. Once trusted, it will be verified on future connections."
          }
        }
      }
    },
    "%lld 个已完成的未读对话": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld completed unread chats"
